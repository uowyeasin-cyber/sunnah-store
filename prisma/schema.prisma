// Pen Miswak store. Money is stored in US cents; other currencies are converted for display.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct connection; Neon on Vercel sets this one too.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Store-wide settings edited in admin: store name, theme, menu, slides, rewards, admins.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sort      Int       @default(0)
  image     String    @default("")
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id         String        @id @default(cuid())
  slug       String        @unique
  name       String
  sub        String        @default("")
  details    String        @default("")
  priceCents Int
  // What one unit costs the store (buying, making, packing), US cents. Used for profit in Reports.
  costCents  Int           @default(0)
  // Built-in drawing used when no photo is uploaded: pen, sticks, oil, attar, sleeve, gift.
  kind       String        @default("gift")
  // Pen finish for the built-in drawing: alu, alug, brassb.
  finish     String        @default("")
  swatch     String        @default("")
  images     String[]
  video      String        @default("")
  active     Boolean       @default(true)
  // Archived products leave the admin list and the shop, and can be restored.
  archived   Boolean       @default(false)
  sort       Int           @default(0)
  // Stock per warehouse: { "US": 10, "MY": 4, "BD": 30 }
  stock      Json          @default("{}")
  // Dropshipping: the supplier ships this product straight to the customer (blind, no prices or supplier logo).
  dropship    Boolean      @default(false)
  supplierId  String       @default("")
  // The supplier's variant ID or SKU (CJ "vid" or SKU); for email suppliers, their product code.
  supplierSku String       @default("")
  supplierUrl String       @default("")
  // The supplier's own price for one unit, US cents, before shipping. Lets the CJ sync move cost (and price) by the real change.
  supplierCost Int         @default(0)
  category   Category      @relation(fields: [categoryId], references: [id])
  categoryId String
  alsoIn     String[]      @default([]) // slugs of other collections this product also shows in
  offer      Offer?
  reviews    Review[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  orderLines OrderLine[]
  views      ProductView[]
}

model Offer {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String    @unique
  on        Boolean   @default(true)
  label     String
  pct       Int       @default(0)
  // ribbon, stamp, pill, glow, timer
  style     String    @default("pill")
  endsAt    DateTime?
  // Buy X get Y free (0 when the offer is a percent off).
  buy       Int       @default(0)
  get       Int       @default(0)
}

model Ad {
  id        String    @id @default(cuid())
  on        Boolean   @default(false)
  // ticker, home-top, home-mid, category, product, popup
  place     String
  kicker    String    @default("")
  title     String
  text      String    @default("")
  cta       String    @default("")
  // product slug, "cat:<slug>", or an https URL
  link      String    @default("")
  // dark, gold, light
  style     String    @default("dark")
  image     String    @default("")
  video     String    @default("")
  startsAt  DateTime?
  endsAt    DateTime?
  views     Int       @default(0)
  clicks    Int       @default(0)
  sort      Int       @default(0)
  createdAt DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  place     String   @default("")
  stars     Int
  text      String
  media     String[]
  // pending, live, hidden
  status    String   @default("pending")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Customer {
  id        String        @id @default(cuid())
  email     String?       @unique
  phone     String?       @unique
  name      String        @default("")
  country   String        @default("")
  address   Json          @default("{}")
  // Store credit, held in the customer's own currency (1 unit = 1 credit).
  currency  String        @default("USD")
  credit    Decimal       @default(0) @db.Decimal(12, 2)
  ledger    CreditEntry[]
  orders    Order[]
  sessions  Session[]
  createdAt DateTime      @default(now())
}

model CreditEntry {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  note       String
  orderNo    String?
  createdAt  DateTime @default(now())
}

model LoginCode {
  id        String   @id @default(cuid())
  to        String
  codeHash  String
  expiresAt DateTime
  tries     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([to])
}

model Session {
  id         String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Order {
  id           String          @id @default(cuid())
  no           String          @unique
  customer     Customer?       @relation(fields: [customerId], references: [id])
  customerId   String?
  name         String
  email        String
  phone        String
  country      String
  address      Json
  currency     String
  // Totals in the order's currency, two decimals.
  subtotal     Decimal         @db.Decimal(12, 2)
  saved        Decimal         @db.Decimal(12, 2)
  shipping     Decimal         @db.Decimal(12, 2)
  creditUsed   Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  rewardEarned Decimal         @db.Decimal(12, 2)
  payMethod    String
  // Where the buyer first came from: utm_source, the referring site, or Direct (set by the proxy).
  source       String          @default("")
  // Social media post or ad the buyer came through (Campaign.code), from a /go link.
  campaign     String          @default("")
  // Coupon code used and the discount it gave, in the order's currency.
  coupon       String          @default("")
  discount     Decimal         @default(0) @db.Decimal(12, 2)
  // Pre-order shipping note at the time of the order, e.g. "Ships in 4–6 weeks". Empty for in-stock orders.
  preorder     String          @default("")
  // True when placing the order took units out of warehouse stock (not in pre-order mode).
  stockHeld    Boolean         @default(false)
  // pending, paid, cod, failed, refunded
  payStatus    String          @default("pending")
  payRef       String          @default("")
  warehouse    String          @default("")
  courier      String          @default("")
  trackingNo   String          @default("")
  // Shipping label from the courier booking, when it gives one.
  labelUrl     String          @default("")
  // 0 placed … 6 delivered, see lib/tracking
  status       Int             @default(0)
  manual       Boolean         @default(false)
  riderName    String          @default("")
  riderPhone   String          @default("")
  etaFrom      DateTime?
  etaTo        DateTime?
  events       Json            @default("[]")
  lines        OrderLine[]
  returns      ReturnRequest[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model OrderLine {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  name      String
  qty       Int
  unit      Decimal  @db.Decimal(12, 2)
  full      Decimal  @db.Decimal(12, 2)
  // Unit cost in the order's currency when the order was placed.
  cost      Decimal  @default(0) @db.Decimal(12, 2)
}

// Money spent running the store (ads, rent, salaries, courier bills…), for profit and loss in Reports.
model Expense {
  id        String   @id @default(cuid())
  date      DateTime
  category  String
  note      String   @default("")
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  createdAt DateTime @default(now())

  @@index([date])
}

// Product page views per day (UTC), for Reports.
model ProductView {
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  day       DateTime @db.Date
  views     Int      @default(0)

  @@id([productId, day])
}

// A social media post or ad. Its /go/<code> link counts clicks, and orders that follow carry the code.
model Campaign {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  // facebook, instagram, youtube, whatsapp, tiktok, messenger, x, google, email, other
  platform   String
  // post or ad
  kind       String    @default("post")
  target     String    @default("/")
  message    String    @default("")
  image      String    @default("")
  currency   String    @default("BDT")
  budget     Decimal   @default(0) @db.Decimal(12, 2)
  spend      Decimal   @default(0) @db.Decimal(12, 2)
  // From the platform: typed in, or synced with its API.
  views      Int       @default(0)
  reach      Int       @default(0)
  shares     Int       @default(0)
  likes      Int       @default(0)
  comments   Int       @default(0)
  // Counted by our own /go link.
  clicks     Int       @default(0)
  // Facebook post or ad id, Instagram media id, YouTube video id.
  externalId String    @default("")
  syncNote   String    @default("")
  syncedAt   DateTime?
  // active, paused, ended
  status     String    @default("active")
  startAt    DateTime  @default(now())
  endAt      DateTime?
  createdAt  DateTime  @default(now())
}

// A customer's request to return an order. The admin approves (refund as store credit) or declines.
model ReturnRequest {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  reason    String
  note      String   @default("")
  // pending, approved, declined
  status    String   @default("pending")
  refund    Decimal  @default(0) @db.Decimal(12, 2)
  adminNote String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Who changed what in the admin panel.
model AdminLog {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  email  String
  area   String   @default("")
  action String
  detail String   @default("")

  @@index([at])
}

// One row each time an automation job runs (on schedule, on an event or by hand).
model AutomationRun {
  id      String   @id @default(cuid())
  job     String
  at      DateTime @default(now())
  trigger String   @default("schedule")
  status  String   @default("ok") // ok, failed, skipped
  summary String   @default("")
  ms      Int      @default(0)

  @@index([job, at])
}

// Work an automation in "approve first" mode wants to do, waiting for an admin.
model AutomationTask {
  id        String    @id @default(cuid())
  job       String
  ref       String
  label     String
  status    String    @default("pending") // pending, done, rejected, failed
  result    String    @default("")
  decidedBy String    @default("")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status, createdAt])
}

// Money ledger: one row per movement. "in" is money received, "out" is money paid back or reversed,
// "credit" is a refund given as store credit (no cash moves). Expenses stay in their own table.
model LedgerEntry {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  dir      String // in, out, credit
  kind     String // gateway, manual, cod, reversal, refund, other
  method   String   @default("")
  amount   Decimal  @db.Decimal(12, 2)
  currency String
  orderId  String?
  orderNo  String   @default("")
  ref      String   @default("")
  note     String   @default("")
  by       String   @default("")

  @@index([at])
  @@index([orderId])
}

// Makers and wholesalers the store buys stock from.
model Supplier {
  id        String          @id @default(cuid())
  name      String
  contact   String          @default("")
  email     String          @default("")
  phone     String          @default("")
  country   String          @default("")
  currency  String          @default("USD")
  leadDays  Int             @default(14)
  notes     String          @default("")
  // Filled by Global sourcing: company website, street address, links to the products we source there, and where it came from.
  website   String          @default("")
  address   String          @default("")
  links     String[]        @default([])
  source    String          @default("")
  // How dropship orders reach this supplier: "cj" (CJ Dropshipping API) or "" (email).
  api       String          @default("")
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]
}

// A purchase from a supplier. Receiving it adds the units to the chosen warehouse's stock.
model PurchaseOrder {
  id         String         @id @default(cuid())
  no         String         @unique
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  supplierId String
  warehouse  String // BD, MY or US; DROP when the supplier ships straight to a customer
  status     String         @default("draft") // draft, ordered, shipped, received, cancelled
  // Dropship: the customer order this was made for, where it ships, and what the supplier sent back.
  saleId     String         @default("")
  saleNo     String         @default("")
  shipTo     Json           @default("{}")
  supplierRef String        @default("")
  trackingNo String         @default("")
  carrier    String         @default("")
  error      String         @default("")
  currency   String
  shipping   Decimal        @default(0) @db.Decimal(12, 2)
  note       String         @default("")
  createdAt  DateTime       @default(now())
  orderedAt  DateTime?
  receivedAt DateTime?
  lines      PurchaseLine[]

  @@index([status])
  @@index([saleId])
}

model PurchaseLine {
  id        String        @id @default(cuid())
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  productId String
  name      String
  qty       Int
  unitCost  Decimal       @db.Decimal(12, 2)
  sku       String        @default("")
}

// Newsletter list. Double opt-in: only confirmed, not-unsubscribed emails get campaigns.
model Subscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  lang         String    @default("en")
  source       String    @default("")
  token        String    @unique
  confirmedAt  DateTime?
  unsubscribed Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

// An email typed at checkout with what was in the bag, for the abandoned-bag reminder.
model CartLead {
  id         String    @id @default(cuid())
  email      String    @unique
  lines      Json // [{ slug, qty }]
  lang       String    @default("en")
  updatedAt  DateTime  @updatedAt
  remindedAt DateTime?
}

// One newsletter send, for the history list.
model MailCampaign {
  id      String   @id @default(cuid())
  subject String
  body    String
  sent    Int      @default(0)
  failed  Int      @default(0)
  by      String   @default("")
  at      DateTime @default(now())
}

// Discount codes typed at checkout. A welcome gift is a one-use coupon tied to one email.
model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  // pct: percent off the items, amount: US cents off the items
  kind      String    @default("pct")
  value     Int
  minCents  Int       @default(0)
  maxUses   Int       @default(0)
  used      Int       @default(0)
  email     String    @default("")
  note      String    @default("")
  on        Boolean   @default(true)
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

// Shop chat: the AI answers; a customer can ask for the seller, and the admin replies in Customer chats.
model ChatThread {
  id         String        @id @default(cuid())
  email      String        @default("")
  name       String        @default("")
  country    String        @default("")
  lang       String        @default("en")
  // The customer pressed "Contact the seller" or the AI could not help.
  needsHuman Boolean       @default(false)
  // The admin took over; the AI stays quiet until resumed.
  aiPaused   Boolean       @default(false)
  closed     Boolean       @default(false)
  unread     Int           @default(0)
  lastAt     DateTime      @default(now())
  createdAt  DateTime      @default(now())
  messages   ChatMessage[]

  @@index([lastAt])
}

model ChatMessage {
  id       String     @id @default(cuid())
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId String
  // user, ai, admin, system
  role     String
  text     String
  at       DateTime   @default(now())

  @@index([threadId, at])
}

// Work given to the AI co-worker or the AI tools, with what it proposed and what was done.
model AiJob {
  id        String   @id @default(cuid())
  kind      String   @default("cowork")
  prompt    String
  // thinking, proposed, done, rejected, failed
  status    String   @default("thinking")
  result    String   @default("")
  actions   Json     @default("[]")
  provider  String   @default("")
  by        String   @default("")
  createdAt DateTime @default(now())
}

// A reminder or a job set for a time: shown on the Dashboard and run by itself when due.
model Scheduled {
  id        String   @id @default(cuid())
  // reminder, or an action: hide_product, show_product, set_offer, stop_offer, book_courier, ai_job
  kind      String   @default("reminder")
  title     String
  note      String   @default("")
  at        DateTime
  data      Json     @default("{}")
  // pending, due (a reminder whose time came), done, cancelled, failed
  status    String   @default("pending")
  result    String   @default("")
  by        String   @default("")
  createdAt DateTime @default(now())

  @@index([status, at])
}

// A short link that shows a short ad page before it opens the target (Admin → Earn money).
model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  target    String
  title     String   @default("")
  on        Boolean  @default(true)
  // Seconds to wait; -1 uses the default from Earn money settings.
  wait      Int      @default(-1)
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}
