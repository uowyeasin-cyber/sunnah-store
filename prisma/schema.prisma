// Pen Miswak store. Money is stored in US cents; other currencies are converted for display.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct connection; Neon on Vercel sets this one too.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Store-wide settings edited in admin: store name, theme, menu, slides, rewards, admins.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sort      Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String
  sub        String      @default("")
  details    String      @default("")
  priceCents Int
  // Built-in drawing used when no photo is uploaded: pen, sticks, oil, attar, sleeve, gift.
  kind       String      @default("gift")
  // Pen finish for the built-in drawing: alu, alug, brassb.
  finish     String      @default("")
  swatch     String      @default("")
  images     String[]
  video      String      @default("")
  active     Boolean     @default(true)
  sort       Int         @default(0)
  // Stock per warehouse: { "US": 10, "MY": 4, "BD": 30 }
  stock      Json        @default("{}")
  category   Category    @relation(fields: [categoryId], references: [id])
  categoryId String
  offer      Offer?
  reviews    Review[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderLines OrderLine[]
}

model Offer {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @unique
  on        Boolean  @default(true)
  label     String
  pct       Int      @default(0)
  // ribbon, stamp, pill, glow, timer
  style     String   @default("pill")
  endsAt    DateTime?
}

model Ad {
  id        String    @id @default(cuid())
  on        Boolean   @default(false)
  // ticker, home-top, home-mid, category, product, popup
  place     String
  kicker    String    @default("")
  title     String
  text      String    @default("")
  cta       String    @default("")
  // product slug, "cat:<slug>", or an https URL
  link      String    @default("")
  // dark, gold, light
  style     String    @default("dark")
  image     String    @default("")
  video     String    @default("")
  startsAt  DateTime?
  endsAt    DateTime?
  views     Int       @default(0)
  clicks    Int       @default(0)
  sort      Int       @default(0)
  createdAt DateTime  @default(now())
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  name      String
  place     String   @default("")
  stars     Int
  text      String
  media     String[]
  // pending, live, hidden
  status    String   @default("pending")
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Customer {
  id        String         @id @default(cuid())
  email     String?        @unique
  phone     String?        @unique
  name      String         @default("")
  country   String         @default("")
  address   Json           @default("{}")
  // Store credit, held in the customer's own currency (1 unit = 1 credit).
  currency  String         @default("USD")
  credit    Decimal        @default(0) @db.Decimal(12, 2)
  ledger    CreditEntry[]
  orders    Order[]
  sessions  Session[]
  createdAt DateTime       @default(now())
}

model CreditEntry {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  amount     Decimal  @db.Decimal(12, 2)
  note       String
  orderNo    String?
  createdAt  DateTime @default(now())
}

model LoginCode {
  id        String   @id @default(cuid())
  to        String
  codeHash  String
  expiresAt DateTime
  tries     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([to])
}

model Session {
  id         String   @id
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  no          String      @unique
  customer    Customer?   @relation(fields: [customerId], references: [id])
  customerId  String?
  name        String
  email       String
  phone       String
  country     String
  address     Json
  currency    String
  // Totals in the order's currency, two decimals.
  subtotal    Decimal     @db.Decimal(12, 2)
  saved       Decimal     @db.Decimal(12, 2)
  shipping    Decimal     @db.Decimal(12, 2)
  creditUsed  Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  rewardEarned Decimal    @db.Decimal(12, 2)
  payMethod   String
  // pending, paid, cod, failed, refunded
  payStatus   String      @default("pending")
  payRef      String      @default("")
  warehouse   String      @default("")
  courier     String      @default("")
  trackingNo  String      @default("")
  // 0 placed … 6 delivered, see lib/tracking
  status      Int         @default(0)
  manual      Boolean     @default(false)
  riderName   String      @default("")
  riderPhone  String      @default("")
  etaFrom     DateTime?
  etaTo       DateTime?
  events      Json        @default("[]")
  lines       OrderLine[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderLine {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  name      String
  qty       Int
  unit      Decimal @db.Decimal(12, 2)
  full      Decimal @db.Decimal(12, 2)
}
