# Copy this file to .env for local use. On Vercel, add the same names under
# Project → Settings → Environment Variables. Only the first block is required.

# ---------- Required ----------
# Postgres connection string. On Vercel: Storage → Neon creates it for you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection, used for database migrations. Neon on Vercel adds it too.
# On a normal Postgres, use the same value as DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Your shop's public address, no slash at the end.
SITE_URL="https://yourshop.com"
# Admin email(s), comma separated. Added to the admin list on every deploy.
SEED_ADMIN_EMAILS="owner@yourshop.com"
# Any long random text. Protects the cron and scheduled-jobs URLs.
CRON_SECRET="change-me-to-a-long-random-string"
# Any long random text. Encrypts the payment, courier and AI keys saved in Admin → Connections.
# Set it before you save any key there, and never change it afterwards.
SECRETS_KEY="change-me-to-another-long-random-string"

# License key from the seller. Without it the store runs as a free demo, then locks.
LICENSE_KEY=""

# ---------- Photos and videos (recommended) ----------
# On Vercel: Storage → Blob creates it. Without it, uploads in the admin do not work.
BLOB_READ_WRITE_TOKEN=""

# ---------- Email: sign-in codes and receipts (pick one) ----------
# Option A, Gmail: a Gmail address + a 16-letter App Password (Google Account → Security → App passwords).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_NAME="My Store"
# Option B, Resend (resend.com): verify your domain there first.
RESEND_API_KEY=""
MAIL_FROM="My Store <orders@yourshop.com>"
# Optional: set to any text, then open /api/mail-test?k=<that text> to send yourself a test mail.
MAIL_TEST_KEY=""

# ---------- Sign in with Google (optional) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to 1 once the two above are filled, to show the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_ON=""

# ---------- Local testing only ----------
# PAY_DEMO=1 adds a fake payment method. Never set it on the live site.
PAY_DEMO=""

# Payment gateways (Stripe, PayPal, SSLCommerz), couriers (Steadfast, Pathao, RedX,
# EasyParcel, Shippo, Ship24), social media and AI keys are typed in
# Admin → Connections. You can also put them here with the same names shown there.
